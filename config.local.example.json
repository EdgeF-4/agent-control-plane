{
  "server": {
    "host": "127.0.0.1",
    "port": 8800,
    "cors_origins": ["http://127.0.0.1:5173", "http://localhost:5173"]
  },
  "database": {
    "url": "sqlite+aiosqlite:///./backend/data/control-plane.db"
  },
  "auth": {
    "jwt_secret": "replace-with-a-random-secret-value",
    "access_token_ttl_minutes": 720,
    "issuer": "agent-control-plane",
    "audience": "control-plane"
  },
  "data_dir": "backend/data",
  "engines": {
    "cost": {
      "database_path": "backend/data/cost.db",
      "default_warn_threshold": 0.8
    },
    "recorder": {
      "log_dir": "backend/data/runs",
      "max_run_bytes": 8388608,
      "max_runs": 5000
    },
    "siem": {
      "redaction": {"enabled": true},
      "sinks": [
        {
          "type": "file",
          "name": "local-audit",
          "enabled": true,
          "path": "backend/data/audit.ndjson"
        }
      ]
    },
    "policy": {
      "default": "allow",
      "rules": [
        {
          "client_id": "*",
          "roles": [],
          "allow": [],
          "deny": ["filesystem__delete*", "shell__*", "database__drop*"]
        }
      ]
    }
  },
  "bootstrap": {
    "tenant_slug": "example",
    "tenant_name": "Example Tenant",
    "admin_email": "admin@example.test",
    "admin_password": "replace-this-password"
  }
}
